# Shared MongoDB replica-set/Atlas database (used by both apps via packages/database)
# URL-encode special characters in the password. Never commit a real connection string.
DATABASE_URL="mongodb+srv://USER:URL_ENCODED_PASSWORD@CLUSTER/dodshop?retryWrites=true&w=majority"

# Keep false in normal development and production. JSON fallback fixtures are
# disabled unless this is explicitly set to "true".
ALLOW_FALLBACK_DB="false"

# Auth — MUST change in production (32+ characters)
JWT_SECRET="your-super-secret-jwt-key-at-least-32-bytes-long"
JWT_EXPIRY="7d"

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Storefront
NEXT_PUBLIC_SITE_URL="https://designsofdreams.com"
